# Set these as Render secret environment variables. Never commit real values.
# Choose the currently supported Graph version shown in your Meta app dashboard.
META_GRAPH_VERSION=vXX.X
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_INSTAGRAM_REDIRECT_URI=https://snipoclip.com/api/social/instagram/callback
META_FACEBOOK_APP_ID=
META_FACEBOOK_APP_SECRET=
META_FACEBOOK_REDIRECT_URI=https://snipoclip.com/api/social/facebook/callback
# Use a long, random key and keep it stable. Existing YouTube tokens also use it.
TOKEN_ENCRYPTION_KEY=
